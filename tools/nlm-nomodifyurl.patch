+		remoteAllocOpts = append(remoteAllocOpts, chromedp.NoModifyURL)
+	}
+	allocCtx, allocCancel := chromedp.NewRemoteAllocator(context.Background(), remoteCDPURL, remoteAllocOpts...)
 	defer allocCancel()

